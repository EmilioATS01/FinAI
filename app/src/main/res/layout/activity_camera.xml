<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@color/bg"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:padding="8dp"
        android:background="@color/card" android:gravity="center_vertical">
        <ImageButton
            android:id="@+id/btnVolver"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:src="@android:drawable/ic_menu_close_clear_cancel"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Volver"/>
        <TextView
            android:text="Escanear ticket"
            android:textStyle="bold" android:textSize="16sp"
            android:layout_marginStart="12dp"
            android:layout_width="wrap_content" android:layout_height="wrap_content"/>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical" android:gravity="center"
        android:padding="24dp">

        <TextView
            android:text="Toma una foto de tu ticket"
            android:textStyle="bold" android:textSize="18sp"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"/>

        <TextView
            android:text="La IA leerá el comercio, el monto y la categoría automáticamente."
            android:textColor="@color/text_secondary"
            android:gravity="center"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginBottom="32dp"/>

        <Button
            android:id="@+id/btnFoto"
            android:text="📷 Tomar foto"
            android:layout_width="wrap_content" android:layout_height="wrap_content"/>
    </LinearLayout>
</LinearLayout>