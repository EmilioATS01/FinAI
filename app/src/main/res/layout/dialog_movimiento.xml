<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical" android:padding="20dp">

    <EditText android:id="@+id/etTitulo"
        android:hint="Título (ej. Supermercado)"
        android:layout_width="match_parent" android:layout_height="wrap_content"/>

    <EditText android:id="@+id/etMonto"
        android:hint="Monto"
        android:inputType="numberDecimal"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="8dp"/>

    <TextView android:text="Categoría" android:layout_marginTop="12dp"
        android:layout_width="wrap_content" android:layout_height="wrap_content"/>
    <Spinner android:id="@+id/spCategoria"
        android:layout_width="match_parent" android:layout_height="wrap_content"/>

    <LinearLayout
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:layout_marginTop="12dp"
        android:gravity="center_vertical">
        <TextView android:text="¿Es ingreso?" android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="wrap_content"/>
        <Switch android:id="@+id/swIngreso"
            android:layout_width="wrap_content" android:layout_height="wrap_content"/>
    </LinearLayout>
</LinearLayout>